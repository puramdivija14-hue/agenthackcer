# ==============================================================================
# Opportunity Radar Backend - Environment Variables
# ==============================================================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Google Gemini API Key (Required for AI Scout & Radar Copilot Chatbot)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Allowed CORS Origins (Comma-separated, or * for all during testing)
# Example: https://your-app.vercel.app,http://localhost:3000
CORS_ORIGIN=*

# Node Environment ('development' or 'production')
NODE_ENV=production
